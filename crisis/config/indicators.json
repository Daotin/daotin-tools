{
  "date_convention": "月度和季度数据的 date 写该期第一天（同美联储经济数据库），日数据和周数据写数据本身的日期",
  "rule_types": {
    "percentile": "处在自身历史最高（side=high）或最低（side=low）的 pct%；只用截至当时估计可见的数据；历史不足 min_history_years 年为数据不足",
    "threshold": "值和 value 按 op 比较，满足即越线；skip_months 里的月份不判断",
    "drawdown_from_high": "从最近 lookback_obs 个观测值的最高点下跌的百分比；达到 watch_pct 为有苗头，达到 trigger_pct 为触发；record_month_trigger 为 true 时另记当月是否有过达到 trigger_pct 的观测值",
    "rise_from_low": "比最近 lookback_obs 个观测值的最低点高出的百分比，达到 pct 为越线",
    "consecutive": "cond 连续满足 trigger_n 期为触发；没有触发时，最新一期满足 watch_cond 为有苗头",
    "compare_same_period": "和上年同一累计期间比较：比上年同期低 watch_drop 个百分点及以上为有苗头，值满足 trigger 为触发",
    "compare_manual_prior": "和人工录入里距最新一条 min_months 到 max_months 个月的那一条比较，满足 flag 时标出；找不到为数据不足（没有录入）",
    "display": "只展示；有 flag 时满足 flag 就标出 flag.label"
  },
  "transform_ops": {
    "yoy_pct": "和 periods 期之前比的百分比变化",
    "yoy_diff": "和 periods 期之前的差",
    "rolling_mean": "最近 n 期的平均",
    "rolling_sum": "最近 n 期的合计",
    "pct_change_obs": "和 n 个观测值之前比的百分比变化",
    "offset": "加上 value"
  },
